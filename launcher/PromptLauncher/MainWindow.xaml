<Window x:Class="PromptLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:PromptLauncher.Core;assembly=PromptLauncher.Core"
        Title="Prompt Workspace Launcher" Width="920" Height="620"
        MinWidth="760" MinHeight="480" WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Import" Click="Import_Click" />
                <Button Content="Export" Click="Export_Click" />
                <Button Content="Shortcut" Click="Shortcut_Click" />
            </StackPanel>
            <TextBox x:Name="SearchBox" FontSize="16" Padding="9,7"
                     ToolTip="Search title, description, category, and prompt text"
                     TextChanged="SearchBox_TextChanged" />
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Folders" FontWeight="SemiBold" Margin="4,0,0,6" />
                <Button DockPanel.Dock="Top" Content="All prompts" HorizontalContentAlignment="Left" Click="AllCategories_Click" />
                <TreeView x:Name="CategoryTree" SelectedItemChanged="CategoryTree_SelectedItemChanged">
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type core:CategoryNode}" ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding Name}" />
                        </HierarchicalDataTemplate>
                    </TreeView.Resources>
                </TreeView>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" />

            <DockPanel Grid.Column="2">
                <TextBlock x:Name="ResultHeading" DockPanel.Dock="Top" Text="Prompts" FontWeight="SemiBold" Margin="4,0,0,6" />
                <ListBox x:Name="PromptList" SelectionChanged="PromptList_SelectionChanged" BorderThickness="1">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4" Width="245">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Description}" Opacity=".72" FontSize="11" TextWrapping="Wrap" MaxHeight="34" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="★" ToolTip="Toggle favorite" Padding="6,2"
                                        Tag="{Binding}" Click="Pin_Click" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" />

            <Grid Grid.Column="4" Margin="8,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="PromptTitle" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />
                <ScrollViewer Grid.Row="1" MaxHeight="180" VerticalScrollBarVisibility="Auto" Margin="0,8">
                    <StackPanel x:Name="VariablesPanel" />
                </ScrollViewer>
                <TextBox x:Name="PreviewBox" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8" />
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="Copy only" Click="Copy_Click" />
                    <Button x:Name="InsertButton" Content="Insert" Click="Insert_Click"
                            Background="{StaticResource AccentBrush}" Foreground="White" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="4,9,4,0" TextWrapping="Wrap" />
    </Grid>
</Window>
