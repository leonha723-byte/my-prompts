<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>PromptWorkspaceLauncher</AssemblyName>
    <RootNamespace>PromptLauncher</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PromptLauncher.Core\PromptLauncher.Core.csproj" />
    <Content Include="..\..\shared\default-prompts.json" Link="Assets\default-prompts.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
